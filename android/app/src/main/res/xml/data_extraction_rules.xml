<?xml version="1.0" encoding="utf-8"?>
<!-- Rien n'est sauvegardé dans le cloud ni transféré vers un autre téléphone : les identifiants de la
     boîte mail restent sur cet appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
